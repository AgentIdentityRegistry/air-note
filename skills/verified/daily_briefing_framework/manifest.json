{
  "id": "bossclaw.skill.daily_briefing_framework",
  "name": "Daily Briefing Framework",
  "version": "1.0.0",
  "description": "Builds a recurring briefing workflow with topic priorities.",
  "author": "BossClaw",
  "minBossClawVersion": "0.1.0",
  "category": ["automation", "operations"],
  "tags": ["briefing", "schedule", "workflow"],
  "runtime": {
    "type": "native",
    "toolId": "mission.daily_briefing"
  },
  "configSchema": {
    "fields": [
      {
        "key": "topics",
        "type": "string[]",
        "label": "Topics",
        "required": true
      },
      {
        "key": "schedule",
        "type": "cron",
        "label": "Schedule",
        "required": true,
        "default": "0 9 * * *"
      },
      {
        "key": "importanceThreshold",
        "type": "number",
        "label": "Importance threshold",
        "required": false,
        "default": 0.7
      }
    ]
  },
  "credentials": [
    {
      "id": "llm.primary",
      "kind": "llm",
      "providers": ["openai", "anthropic", "google"],
      "required": true
    },
    {
      "id": "search.optional",
      "kind": "search",
      "providers": ["brave", "tavily"],
      "required": false
    }
  ],
  "permissions": {
    "network": {
      "default": "deny",
      "allowDomains": [],
      "allowUserAddDomains": true,
      "approval": "once_then_remember"
    },
    "files": {
      "default": "deny",
      "allowPaths": [],
      "approval": "once_then_remember"
    },
    "clipboard": {
      "default": "deny",
      "approval": "once_then_remember"
    },
    "notifications": {
      "default": "allow"
    }
  },
  "automation": {
    "supportsSchedule": true,
    "supportsTriggers": ["manual", "schedule"]
  },
  "budget": {
    "defaultMonthlyUsd": 20,
    "actionOnExceed": "pause_and_notify"
  },
  "ui": {
    "entrypoints": [
      {
        "id": "configure_briefing",
        "label": "Configure briefing",
        "type": "settings"
      }
    ],
    "showInStore": true
  },
  "trust": {
    "channel": "verified",
    "signed": false,
    "source": {
      "type": "local"
    }
  }
}
