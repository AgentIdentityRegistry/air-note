{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bossclaw.ai/schemas/manifest.v1.schema.json",
  "title": "BossClaw Skill Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "author",
    "minBossClawVersion",
    "runtime",
    "permissions",
    "trust"
  ],
  "properties": {
    "id": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^bossclaw\\.skill\\.[A-Za-z0-9._-]+$"
        },
        {
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "minBossClawVersion": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "configSchema": {
      "$ref": "#/$defs/configSchema"
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential"
      }
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "automation": {
      "$ref": "#/$defs/automation"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "ui": {
      "$ref": "#/$defs/ui"
    },
    "trust": {
      "$ref": "#/$defs/trust"
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["mcp", "native"]
        },
        "transport": {
          "enum": ["stdio", "http"]
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "toolId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcp"
              }
            }
          },
          "then": {
            "required": ["transport", "package"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "native"
              }
            }
          },
          "then": {
            "required": ["toolId"]
          }
        }
      ]
    },
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "label"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["string", "string[]", "number", "boolean", "cron", "enum"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": ["options"]
          }
        }
      ]
    },
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configField"
          }
        }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "providers", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["llm", "search", "connector"]
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "networkPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowDomains", "allowUserAddDomains", "approval"],
      "properties": {
        "default": {
          "enum": ["deny", "allow"]
        },
        "allowDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowUserAddDomains": {
          "type": "boolean"
        },
        "approval": {
          "enum": ["always_confirm", "once_then_remember"]
        }
      }
    },
    "filesPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allowPaths", "approval"],
      "properties": {
        "default": {
          "enum": ["deny", "allow"]
        },
        "allowPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "enum": ["always_confirm_destructive", "once_then_remember"]
        }
      }
    },
    "clipboardPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "approval"],
      "properties": {
        "default": {
          "enum": ["deny", "allow"]
        },
        "approval": {
          "enum": ["always_confirm", "once_then_remember"]
        }
      }
    },
    "notificationsPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "enum": ["deny", "allow"]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "files", "clipboard", "notifications"],
      "properties": {
        "network": {
          "$ref": "#/$defs/networkPermissions"
        },
        "files": {
          "$ref": "#/$defs/filesPermissions"
        },
        "clipboard": {
          "$ref": "#/$defs/clipboardPermissions"
        },
        "notifications": {
          "$ref": "#/$defs/notificationsPermissions"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportsSchedule", "supportsTriggers"],
      "properties": {
        "supportsSchedule": {
          "type": "boolean"
        },
        "supportsTriggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMonthlyUsd", "actionOnExceed"],
      "properties": {
        "defaultMonthlyUsd": {
          "type": "number",
          "minimum": 0
        },
        "actionOnExceed": {
          "enum": ["pause_and_notify", "notify_only", "hard_stop"]
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["command", "settings"]
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string"
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entrypoint"
          }
        },
        "showInStore": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["registry", "local"]
        },
        "url": {
          "type": "string",
          "pattern": "^https?://.+"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "registry"
              }
            }
          },
          "then": {
            "required": ["url"]
          }
        }
      ]
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "signed", "source"],
      "properties": {
        "channel": {
          "enum": ["verified", "community", "local"]
        },
        "signed": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
