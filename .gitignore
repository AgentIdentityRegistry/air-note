# Rust
/target
crates/*/target

# Node
node_modules/
npm-debug.log*

# Local agent identity / keys / archive — NEVER commit
.air-msg/

# OS / editor
.DS_Store
*.log

# BossClaw desktop app build output
dist
build
*.tsbuildinfo

# Env files — NEVER commit (only .env.example is tracked)
.env
.env.*
.env.local
!.env.example
!**/.env.example

# Local agent tooling state (machine-specific; GBrain is canonical for handoffs)
.claude/
.omc/
.gstack/
.superpowers/
NEXT-SESSION.md

# SP2: the bundled embedding model is fetched (hash-pinned), never committed.
# Keep the README placeholder (so the Tauri bundle glob is non-empty in a fresh
# checkout); ignore only the fetched model blobs.
/apps/desktop/src-tauri/resources/models/potion-base-8M/*
!/apps/desktop/src-tauri/resources/models/potion-base-8M/README.md

# M1a Task 8: the bossclawd sidecar for Tauri externalBin is a BUILD ARTIFACT
# (staged from `cargo build -p bossclawd` with the target-triple suffix Tauri
# requires). Never committed; the dir is kept (via .gitkeep) so the externalBin
# path exists in a fresh checkout.
/apps/desktop/src-tauri/binaries/*
!/apps/desktop/src-tauri/binaries/.gitkeep
